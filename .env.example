# ---------------------------------------------------------------------------
# UNILAG Yearbook — environment
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, auth email links and payment callbacks.
APP_URL=http://localhost:3000

# Shown on About, Privacy and Terms. Set before launch.
OPERATOR_NAME=
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API). Local CLI values are printed by `supabase start`.
#
# The URL and anon/publishable key are public by design — RLS and column grants
# protect the data. The service-role/secret key bypasses RLS: server-only, never
# prefix it with NEXT_PUBLIC_, never expose it to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payments (Paystack). Without a secret key, checkout is disabled unless the
# local harness below is explicitly enabled. sk_test_ keys record payments as
# mode "test" (excluded from revenue).
#
# Webhook URL to set in the Paystack dashboard:
#   https://<your-domain>/api/webhooks/paystack
# ---------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local development only — refused when NODE_ENV=production. Records a clearly
# labelled "dev-harness" payment instead of a real gateway payment.
ALLOW_TEST_PAYMENTS=false

# ---------------------------------------------------------------------------
# Studid academic verification (https://studid.io/docs)
#
# UNILAG is not yet confirmed in Studid's identity-federation network, so leave
# this off until the university's SAML entityId is confirmed. When it is:
#   STUDID_ENABLED=true
#   STUDID_ALLOWED_ENTITY_PREFIX=https://idp.unilag.edu.ng/
# Only logins whose entityId starts with that prefix are accepted. Until then,
# students are verified by manual review of a student ID.
# ---------------------------------------------------------------------------
STUDID_ENABLED=false
# STUDID_ALLOWED_ENTITY_PREFIX=

# ---------------------------------------------------------------------------
# Transactional email (verification decisions, page published, Faces selection)
# via Resend (https://resend.com). Unset = messages are logged, not sent.
# Use a domain you have verified with the provider.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="UNILAG Yearbook <hello@yourdomain.com>"
